# Makuwatsine Chirenje Attorneys — Apache (cPanel) rules
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Pretty article URLs: /blog/my-article -> post.php?slug=my-article
  RewriteRule ^blog/([A-Za-z0-9\-]+)/?$ post.php?slug=$1 [L,QSA]
</IfModule>

# Never serve config, SQL, docs or git metadata
<FilesMatch "(^\.|\.(sql|md|yml|yaml|lock|sample\.php)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression + caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>

# Force HTTPS once an SSL certificate (AutoSSL) is active — uncomment:
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
